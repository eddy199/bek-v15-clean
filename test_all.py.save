def lancer_tests():
    for config in modeles:
        model_name = config["name"]
        print(f"\n==========================================")
        print(f"Test du modèle : {model_name}")
        print(f"==========================================")
        
        try:
            if config["type"] == "stream_thinking":
                completion = client.chat.completions.create(
                    model=model_name,
                    messages=config["messages"],
                    temperature=config["temperature"],
                    top_p=config["top_p"],
                    max_tokens=config["max_tokens"],
                    extra_body=config["extra_body"],
                    stream=True
                )
                for chunk in completion:
                    if not chunk.choices:
                        continue
                    reasoning = getattr(chunk.choices[0].delta, "reasoning_content", None)
                    if reasoning:
                        print(reasoning, end="")
                    if chunk.choices[0].delta.content is not None:
                        print(chunk.choices[0].delta.content, end="")
                print()

            elif config["type"] == "chat_with_reasoning":
                completion = client.chat.completions.create(
                    model=model_name,
                    messages=config["messages"],
                    temperature=config["temperature"],
                    top_p=config["top_p"],
                    max_tokens=config["max_tokens"],
                    stream=False
                )
                reasoning = getattr(completion.choices[0].message, "reasoning_content", None)
                if reasoning:
                    print("--- Raisonnement ---")
                    print(reasoning)
                print("--- Réponse ---")
                print(completion.choices[0].message.content)

            else: # Standard chat
                kwargs = {
                    "model": model_name,
                    "messages": config["messages"],
                    "temperature": config["temperature"],
                    "top_p": config["top_p"],
                    "max_tokens": config["max_tokens"],
                    "stream": config["stream"]
                }
                if "seed" in config:
                    kwargs["seed"] = config["seed"]
                if "extra_body" in config:
                    kwargs["extra_body"] = config["extra_body"]

                completion = client.chat.completions.create(**kwargs)
                
                reasoning = getattr(completion.choices[0].message, "reasoning", None) or getattr(completion.choices[0].message, "reasoning_content", None)
                if reasoning:
                    print("--- Raisonnement ---")
                    print(reasoning)
                print("--- Réponse ---")
                print(completion.choices[0].message.content)

        except Exception as e:
            print(f"Erreur lors du test de {model_name} : {e}")

if __name__ == "__main__":
    lancer_tests()
