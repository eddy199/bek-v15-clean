{
  "name": "crm_sync",
  "version": "1.0.0",
  "risk_level": "L2",
  "description": "Transformation et synchronisation des fiches contacts et entités dans Neon DB.",
  "parameters": {
    "type": "object",
    "properties": {
      "entity_type": {
        "type": "string",
        "enum": ["contact", "company", "task"],
        "description": "Type d'entité CRM à traiter."
      },
      "action": {
        "type": "string",
        "enum": ["upsert", "update", "archive"],
        "default": "upsert",
        "description": "Opération de persistance à exécuter."
      },
      "payload": {
        "type": "object",
        "description": "Données métier structurées de l'entité."
      },
      "target_table": {
        "type": "string",
        "default": "bek_crm_records",
        "description": "Table cible dans Neon DB."
      }
    },
    "required": ["entity_type", "payload"]
  },
  "events": {
    "on_success": "skill.crm_sync.completed",
    "on_failure": "skill.crm_sync.failed"
  }
}