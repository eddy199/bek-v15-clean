{
  "abreviation": "BEK-FLUX",
  "nom_complet": "Fast Layered Unified eXecution",
  "sous_titre": "DAG-Based Web Orchestration",
  "version": "1.0",
  "date": "2026-09-23",
  "author": "BEK Project",
  "license": "BEK-LVC-v1.0",

  "description": "Parallélise les tâches via un DAG Engine. 10 workers simultanés. Gain : 3x plus rapide.",

  "brevet": "docs/brevets/BREVET_FLUX.md",
  "module": "bek_core.flux.executor",
  "package": "bek_core.flux",

  "functions": {
    "run": {
      "params": ["tasks"],
      "optional": ["workers", "timeout"],
      "returns": "dict",
      "description": "Exécute des tâches en parallèle via DAG"
    },
    "run_parallel": {
      "params": ["functions"],
      "optional": ["args_list", "workers"],
      "returns": "list",
      "description": "Version simplifiée : N fonctions en parallèle"
    }
  },

  "classes": {
    "BekFluxExecutor": {
      "description": "Exécuteur DAG principal",
      "methods": ["run", "run_parallel"]
    }
  },

  "constants": {
    "BEK_FLUX_DEFAULT_WORKERS": 10,
    "BEK_FLUX_DEFAULT_TIMEOUT": 25.0
  },

  "performance": {
    "workers_default": 10,
    "speedup_vs_sequential": 3.0,
    "speedup_vs_pool3": 3.0,
    "elapsed_ms_15_tasks": 8000
  },

  "dependencies": [],
  "used_by": ["BEK-WEB", "BEK-HERMES", "BEK-AGENT-v18"],

  "status": "active",
  "priority": "critical"
}