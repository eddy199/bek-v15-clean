# ==============================================================================
# BEK-v19 HYBRID — MODÈLE DE CONFIGURATION D'ENVIRONNEMENT
# Copiez ce fichier en "env.txt" (ou ".env") et remplissez vos propres clés.
# ==============================================================================

NODE_ENV=development
PORT=3001
HOST=127.0.0.1
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379/0
BEK_EVENTBUS_MODE=auto
BEK_EVENTBUS_MAXLEN=10000

# --- Base de données (Neon/Supabase PostgreSQL) ---
DATABASE_URL=

# --- Authentification ---
BETTER_AUTH_SECRET=
AUTH_BYPASS=true
ALLOWED_SIGN_IN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Fournisseurs LLM (Clés) ---
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=

NVIDIA_API_KEY=
GROQ_API_KEY=
# GEMINI_API_KEY=
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=
B_AI_API_KEY=
BEATAPI_API_KEY=
COHERE_API_KEY=
AIONLABS_API_KEY=
AISA_API_KEY=
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
HUGGINGFACE_API_KEY=
FIRECRAWL_API_KEY=

MISTRAL_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
OLLAMA_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# ★ BEK BRAIN — ROUTAGE PROVIDER
# ══════════════════════════════════════════════════════════════════════════════
BEK_ANALYSIS_PROVIDER=nvidia
BEK_ANALYSIS_MODEL=meta/llama-4-maverick-17b-128e-instruct

BEK_FALLBACK_PROVIDER=groq
BEK_FALLBACK_MODEL=llama-3.3-70b-versatile

BEK_DEFAULT_CHAT_PROVIDER=nvidia
BEK_DEFAULT_CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

BEK_ANALYSIS_QUERY_THRESHOLD=30000
BEK_MAX_INDIVIDUAL_FILE_CHARS=20000
BEK_MAX_TOTAL_FILE_CONTEXT_CHARS=200000
BEK_CHUNK_SIZE_FILES=3
BEK_CHUNK_THRESHOLD_FILES=3
BEK_RATE_LIMIT_DELAY_SEC=1.0

BEK_MAX_RETRIES_PER_CALL=2
BEK_RETRY_BASE_SLEEP_SEC=5.0
BEK_CIRCUIT_BREAKER_THRESHOLD=2
BEK_CIRCUIT_BREAKER_COOLDOWN_SEC=300

BEK_TOOL_CAPABLE_PROVIDERS=groq,nvidia,openrouter,kimi,ollama_cloud,mistral,cohere,huggingface,b_ai,beatapi

# --- Mémoire Vectorielle (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bek-memory-v2

# --- Hindsight Memory ---
BEK_HINDSIGHT_ENABLED=true
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=bek-agent
HINDSIGHT_TIMEOUT=30

# --- Embeddings ---
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings

# --- Sécurité BEK & API ---
FLASK_SECRET_KEY=
BEK_HSM_SECRET=
BEK_OPENAI_API_KEY=

# --- Google Services ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_SUBDOMAIN=quickvivals.workers.dev

# --- GitHub ---
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- Divers ---
BYBIT_2FA_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
# ★ FEATURE FLAGS DES NERFS
# ══════════════════════════════════════════════════════════════════════════════
BEK_ENABLE_EVENT_BUS_NERVES=true
BEK_ENABLE_HERMES_NERVES=true
BEK_ENABLE_SKILLS_NERVES=true
BEK_ENABLE_HEADLESS_NERVES=true
BEK_ENABLE_TMUX_NERVES=true
BEK_ENABLE_WEB_AGENT_NERVES=true
BEK_ENABLE_GUARDIAN_NERVES=true
BEK_ENABLE_APPROVAL_NERVES=true
BEK_ENABLE_MCP_NERVES=true
BEK_ENABLE_COGNITIVE_NERVES=true
BEK_ENABLE_ROUTER_NERVES=true
BEK_ENABLE_CODER_NERVES=true
BEK_ENABLE_CRM_NERVES=false

# ══════════════════════════════════════════════════════════════════════════════
# ★ PARAMÈTRES AVANCÉS DE CHAT
# ══════════════════════════════════════════════════════════════════════════════
BEK_CHAT_HISTORY_WINDOW=6
BEK_STREAM_TIMEOUT_SEC=300
BEK_CHAT_MAX_CHARS_PER_MSG=20000
BEK_CHAT_MAX_TOTAL_CHARS=60000
BEK_ASYNC_UTILS_TIMEOUT=60
BEK_CHAT_MAX_ARCHITECTURE_CHARS=20000
BEK_CHAT_DEFAULT_PROVIDER=nvidia
BEK_CHAT_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
BEK_CHAT_MAX_TOTAL_ACTIONS=2
BEK_CHAT_POOR_RESULT_THRESHOLD=200
BEK_CHAT_MAX_QUERY_WORDS=8
BEK_CHAT_MAX_CHUNKS_NO_CLOSE=150
BEK_COGNITIVE_MIN_DRAFT_LENGTH=200
BEK_COGNITIVE_MIN_GROUNDING_LENGTH=100
BEK_MAX_TOKENS=8192

BEK_FORGE_AUTO_STAGING=false
BEK_FORGE_MIN_CONFIDENCE=0.75
BEK_FORGE_MAX_PROPOSALS_PER_CYCLE=5

BEK_WEB_SYNC_MAX_SOURCES=15
BEK_WEB_SYNC_MIN_SOURCES=5
BEK_WEB_SYNC_TIMEOUT_PER_PAGE=25
BEK_WEB_SYNC_ENABLE_SWARM=true
BEK_WEB_SYNC_ENABLE_DAG=true
BEK_WEB_SYNC_DAG_WORKERS=10
BEK_WEB_SYNC_PRECISION_MODE=high
BEK_WEB_SYNC_REQUIRE_SWARM=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=bek-v19-hybrid
OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4317
OTEL_SAMPLE_RATIO=1.0
OTEL_CONSOLE_EXPORT=true

BEK_LAZY_LOAD=true
BEK_LAZY_LOAD_PLAYWRIGHT=true
BEK_LAZY_LOAD_CHROMADB=true
BEK_LAZY_LOAD_DUCKDB=true
BEK_DISABLE_CHROMADB=false
BEK_DISABLE_DUCKDB_ANALYTICS=false

BEK_VAD_SILENCE=1.8
BEK_AUDIO_DUCK_VOLUME=0.15
BEK_AUDIO_KEEP_ALIVE_DURING_DAG=true
APP_TITLE=BEK Hybrid Agent v19
APP_CREATOR=BEKKARA Mohamed