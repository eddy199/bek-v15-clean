generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model activity {
  id              String         @id
  type            ActivityType
  subject         String?
  body            String?
  occurredAt      DateTime?
  dueAt           DateTime?
  completedAt     DateTime?
  companyId       String?
  contactId       String?
  dealId          String?
  createdById     String
  meta            Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  calendarEventId String?        @unique
  emailThreadId   String?        @unique
  calendarEvent   calendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  company         company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact         contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user            user           @relation(fields: [createdById], references: [id])
  deal            deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  emailThread     emailThread?   @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
  @@index([createdById])
  @@index([dealId, createdAt])
  @@index([dueAt])
}

model agentAction {
  id              String            @id
  agentId         String
  runId           String
  type            String
  provider        String
  targetType      String?
  targetId        String?
  targetLabel     String?
  summary         String
  metadata        Json?
  status          AgentActionStatus @default(PLANNED)
  idempotencyKey  String            @unique
  requestHash     String?
  externalId      String?
  attemptCount    Int               @default(0)
  errorCode       String?
  errorMessage    String?
  plannedAt       DateTime          @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime
  agentDefinition agentDefinition   @relation(fields: [agentId], references: [id])
  agentRun        agentRun          @relation(fields: [runId, agentId], references: [id, agentId])

  @@index([agentId, plannedAt])
  @@index([provider, externalId])
  @@index([runId, plannedAt])
  @@index([status, plannedAt])
}

model agentAuditEvent {
  id              String          @id
  agentId         String
  versionId       String?
  actorUserId     String?
  type            String
  actorType       String
  actorId         String?
  summary         String
  before          Json?
  after           Json?
  requestId       String?
  emittedAt       DateTime        @default(now())
  user            user?           @relation(fields: [actorUserId], references: [id])
  agentDefinition agentDefinition @relation(fields: [agentId], references: [id])
  agentVersion    agentVersion?   @relation(fields: [versionId, agentId], references: [id, agentId])

  @@unique([agentId, type, requestId])
  @@index([actorUserId, emittedAt])
  @@index([agentId, emittedAt])
  @@index([type, emittedAt])
  @@index([versionId, emittedAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agentBuilderArtifact {
  id                String                     @id
  conversationId    String?
  versionId         String?
  path              String
  language          String
  content           String
  previousContent   String?
  revision          Int
  status            AgentBuilderArtifactStatus @default(WRITING)
  createdAt         DateTime                   @default(now())
  agentConversation agentConversation?         @relation(fields: [conversationId], references: [id])
  agentVersion      agentVersion?              @relation(fields: [versionId], references: [id])

  @@unique([conversationId, path, revision], map: "agentBuilderArtifact_conversation_path_revision_key", where: raw("(\"conversationId\" IS NOT NULL)"))
  @@unique([versionId, path, revision], map: "agentBuilderArtifact_version_path_revision_key", where: raw("(\"versionId\" IS NOT NULL)"))
  @@index([conversationId, createdAt])
  @@index([versionId, path])
}

model agentConversation {
  id                          String                        @id
  contactId                   String?
  companyId                   String?
  userId                      String
  sessionId                   String?                       @unique
  continuationToken           String?
  streamIndex                 Int                           @default(0)
  title                       String?
  messageCount                Int                           @default(0)
  createdAt                   DateTime                      @default(now())
  lastMessageAt               DateTime                      @default(now())
  dealId                      String?
  kind                        AgentConversationKind         @default(RECORD)
  agentId                     String?
  updatedAt                   DateTime
  lastAssistantAt             DateTime?
  lastReadAt                  DateTime?
  pendingInputRequest         Json?
  agentBuilderArtifact        agentBuilderArtifact[]
  agentDefinition             agentDefinition?              @relation(fields: [agentId], references: [id])
  company                     company?                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact                     contact?                      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal                        deal?                         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user                        user                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentConversationFeedback   agentConversationFeedback[]
  agentConversationShare      agentConversationShare?
  agentConversationSubmission agentConversationSubmission[]
  agentEvent                  agentEvent[]
  agentVersion                agentVersion[]

  @@index([agentId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([contactId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([userId, kind, lastMessageAt])
}

model agentConversationAttachment {
  id                          String                      @id
  submissionId                String
  name                        String
  mediaType                   String
  size                        Int
  content                     Bytes
  position                    Int
  createdAt                   DateTime                    @default(now())
  agentConversationSubmission agentConversationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, position])
}

model agentConversationFeedback {
  id                String              @id
  conversationId    String
  userId            String
  messageId         String
  rating            AgentResponseRating
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  agentConversation agentConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              user                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId, messageId])
  @@index([conversationId, createdAt])
}

model agentConversationShare {
  id                String                      @id
  conversationId    String                      @unique(map: "agentConversationShare_one_active_per_conversation", where: raw("(\"revokedAt\" IS NULL)"))
  createdById       String
  scope             AgentConversationShareScope @default(WORKSPACE_LINK)
  tokenHash         String                      @unique
  createdAt         DateTime                    @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  agentConversation agentConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              user                        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([conversationId, revokedAt])
}

model agentConversationSubmission {
  id                          String                            @id
  conversationId              String
  submittedById               String
  clientRequestId             String                            @unique
  message                     Json
  status                      AgentConversationSubmissionStatus @default(PENDING)
  attemptCount                Int                               @default(0)
  errorCode                   String?
  errorMessage                String?
  createdAt                   DateTime                          @default(now())
  sentAt                      DateTime?
  acceptedAt                  DateTime?
  commandType                 AgentConversationCommandType      @default(CHAT)
  inputRequestId              String?
  agentConversationAttachment agentConversationAttachment[]
  agentConversation           agentConversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                        user                              @relation(fields: [submittedById], references: [id])

  @@unique([conversationId, inputRequestId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model agentDefinition {
  id                                                             String                @id
  name                                                           String
  description                                                    String?
  status                                                         AgentDefinitionStatus @default(DRAFT)
  createdById                                                    String
  currentVersionId                                               String?               @unique
  createdAt                                                      DateTime              @default(now())
  updatedAt                                                      DateTime
  archivedAt                                                     DateTime?
  deletedAt                                                      DateTime?
  agentAction                                                    agentAction[]
  agentAuditEvent                                                agentAuditEvent[]
  agentConversation                                              agentConversation[]
  user                                                           user                  @relation(fields: [createdById], references: [id])
  agentVersion_agentDefinition_currentVersionId_idToagentVersion agentVersion?         @relation("agentDefinition_currentVersionId_idToagentVersion", fields: [currentVersionId, id], references: [id, agentId])
  agentRun                                                       agentRun[]
  agentTrigger                                                   agentTrigger[]
  agentVersion_agentVersion_agentIdToagentDefinition             agentVersion[]        @relation("agentVersion_agentIdToagentDefinition")

  @@unique([currentVersionId, id])
  @@index([createdById, createdAt])
  @@index([status, updatedAt])
}

model agentEvent {
  id                String             @id
  sessionId         String
  contactId         String?
  type              String
  data              Json
  emittedAt         DateTime
  conversationId    String?
  agentConversation agentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([contactId, emittedAt])
  @@index([conversationId, emittedAt])
  @@index([sessionId, emittedAt])
}

model agentRun {
  id                String           @id
  agentId           String
  versionId         String
  triggerId         String?
  initiatedById     String?
  triggerType       AgentTriggerType
  status            AgentRunStatus   @default(QUEUED)
  principalId       String?
  sessionId         String?          @unique
  idempotencyKey    String           @unique
  correlationId     String           @unique
  input             Json?
  result            Json?
  summary           String?
  modelId           String?
  inputTokens       Int?
  outputTokens      Int?
  costUsd           Decimal?         @db.Decimal(12, 6)
  errorCode         String?
  errorMessage      String?
  nextEventSequence Int              @default(0)
  createdAt         DateTime         @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  cancelDeliveredAt DateTime?
  cancelRequestedAt DateTime?
  agentAction       agentAction[]
  agentDefinition   agentDefinition  @relation(fields: [agentId], references: [id])
  user              user?            @relation(fields: [initiatedById], references: [id])
  agentTrigger      agentTrigger?    @relation(fields: [triggerId, agentId], references: [id, agentId])
  agentVersion      agentVersion     @relation(fields: [versionId, agentId], references: [id, agentId])
  agentRunEvent     agentRunEvent[]

  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@index([triggerId, createdAt])
  @@index([versionId, createdAt])
}

model agentRunEvent {
  id        String   @id
  runId     String
  sequence  Int
  type      String
  data      Json
  emittedAt DateTime @default(now())
  agentRun  agentRun @relation(fields: [runId], references: [id])

  @@unique([runId, sequence])
  @@index([runId, emittedAt])
}

model agentTask {
  id          String    @id
  contactId   String?
  companyId   String?
  kind        String
  reason      String
  priority    Int       @default(0)
  budget      Int       @default(4)
  dueAt       DateTime
  leasedUntil DateTime?
  sessionId   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  outcome     String?
  createdAt   DateTime  @default(now())
  attempts    Int       @default(0)
  dealId      String?
  payload     Json?
  subject     String?

  @@index([contactId])
  @@index([dealId])
  @@index([dueAt, leasedUntil])
  @@index([kind, subject], where: raw("(\"finishedAt\" IS NULL)"))
}

model agentTrigger {
  id              String           @id
  agentId         String
  versionId       String
  type            AgentTriggerType
  name            String
  config          Json
  createdById     String
  enabled         Boolean          @default(false)
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  agentRun        agentRun[]
  agentDefinition agentDefinition  @relation(fields: [agentId], references: [id])
  user            user             @relation(fields: [createdById], references: [id])
  agentVersion    agentVersion     @relation(fields: [versionId, agentId], references: [id, agentId])

  @@unique([id, agentId])
  @@index([agentId, enabled])
  @@index([enabled, nextRunAt])
  @@index([versionId])
}

model agentVersion {
  id                                                                String                 @id
  agentId                                                           String
  number                                                            Int
  status                                                            AgentVersionStatus     @default(DRAFT)
  instructions                                                      String
  manifest                                                          Json
  modelId                                                           String
  sandboxPolicy                                                     Json
  validation                                                        Json?
  sourceConversationId                                              String?
  createdById                                                       String
  deploymentId                                                      String?
  approvedAt                                                        DateTime?
  deployedAt                                                        DateTime?
  createdAt                                                         DateTime               @default(now())
  modelContextWindowTokens                                          Int                    @default(1000000)
  agentAuditEvent                                                   agentAuditEvent[]
  agentBuilderArtifact                                              agentBuilderArtifact[]
  agentDefinition_agentDefinition_currentVersionId_idToagentVersion agentDefinition?       @relation("agentDefinition_currentVersionId_idToagentVersion")
  agentRun                                                          agentRun[]
  agentTrigger                                                      agentTrigger[]
  agentDefinition_agentVersion_agentIdToagentDefinition             agentDefinition        @relation("agentVersion_agentIdToagentDefinition", fields: [agentId], references: [id])
  user                                                              user                   @relation(fields: [createdById], references: [id])
  agentConversation                                                 agentConversation?     @relation(fields: [sourceConversationId], references: [id])

  @@unique([agentId, number])
  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([status, createdAt])
}

model appSetting {
  id                       String    @id
  agentModelId             String?
  agentModelContextWindow  Int?
  updatedAt                DateTime
  contextDevApiKey         String?
  reportingCurrency        String?
  ratesRefreshedAt         DateTime?
  trackingSiteId           String?   @unique
  trackingCrossDomain      Boolean   @default(true)
  trackingLimitToDomains   Boolean   @default(true)
  trackingCookieSubdomains Boolean   @default(false)
  trackingSecureCookies    Boolean   @default(true)
  trackingHonourDnt        Boolean   @default(true)
  trackingCookieDays       Int       @default(395)
  trackingConfigHash       String?
  trackingPaused           Boolean   @default(false)
}

model calendarAttendee {
  id             String        @id
  eventId        String
  email          String
  name           String?
  responseStatus String?
  isOrganizer    Boolean       @default(false)
  contactId      String?
  contact        contact?      @relation(fields: [contactId], references: [id])
  calendarEvent  calendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([contactId])
}

model calendarEvent {
  id                String             @id
  iCalUid           String
  originalStartTime DateTime
  recurringEventId  String?
  title             String?
  description       String?
  location          String?
  conferenceUrl     String?
  startsAt          DateTime
  endsAt            DateTime
  isAllDay          Boolean            @default(false)
  status            String
  organizerEmail    String?
  companyId         String?
  contactId         String?
  syncedByUserId    String?
  googleEventId     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  activity          activity?
  calendarAttendee  calendarAttendee[]
  company           company?           @relation(fields: [companyId], references: [id])
  contact           contact?           @relation(fields: [contactId], references: [id])

  @@unique([iCalUid, originalStartTime])
  @@index([companyId, startsAt])
  @@index([contactId, startsAt])
}

model company {
  id                                        String              @id
  name                                      String
  domain                                    String?             @unique
  website                                   String?
  description                               String?
  logoUrl                                   String?
  logoDarkUrl                               String?
  iconUrl                                   String?
  brandColor                                String?
  industry                                  String?
  subIndustry                               String?
  city                                      String?
  stateCode                                 String?
  country                                   String?
  countryCode                               String?
  phone                                     String?
  email                                     String?
  linkedinUrl                               String?
  twitterUrl                                String?
  githubUrl                                 String?
  pricingUrl                                String?
  careersUrl                                String?
  ownerId                                   String?
  primaryContactId                          String?             @unique
  enrichmentStatus                          EnrichmentStatus    @default(PENDING)
  enrichedAt                                DateTime?
  enrichmentError                           String?
  createdAt                                 DateTime            @default(now())
  updatedAt                                 DateTime
  source                                    RecordSource        @default(MANUAL)
  lastActivityAt                            DateTime?
  iconDarkUrl                               String?
  iconTone                                  String?
  activity                                  activity[]
  agentConversation                         agentConversation[]
  calendarEvent                             calendarEvent[]
  user                                      user?               @relation(fields: [ownerId], references: [id])
  contact_company_primaryContactIdTocontact contact?            @relation("company_primaryContactIdTocontact", fields: [primaryContactId], references: [id])
  companyEnrichment                         companyEnrichment?
  contact_contact_companyIdTocompany        contact[]           @relation("contact_companyIdTocompany")
  deal                                      deal[]
  emailThread                               emailThread[]
  fieldValue                                fieldValue[]

  @@index([lastActivityAt])
  @@index([name])
  @@index([ownerId])
}

model companyEnrichment {
  companyId String   @id
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())
  company   company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model contact {
  id                                        String              @id
  firstName                                 String
  lastName                                  String?
  email                                     String?             @unique
  phone                                     String?
  title                                     String?
  linkedinUrl                               String?
  companyId                                 String?
  ownerId                                   String?
  createdAt                                 DateTime            @default(now())
  updatedAt                                 DateTime
  source                                    RecordSource        @default(MANUAL)
  lastActivityAt                            DateTime?
  imageUrl                                  String?
  githubUrl                                 String?
  twitterUrl                                String?
  socialsCheckedAt                          DateTime?
  enrichedAt                                DateTime?
  enrichmentError                           String?
  enrichmentStatus                          EnrichmentStatus    @default(PENDING)
  activity                                  activity[]
  agentConversation                         agentConversation[]
  calendarAttendee                          calendarAttendee[]
  calendarEvent                             calendarEvent[]
  company_company_primaryContactIdTocontact company?            @relation("company_primaryContactIdTocontact")
  company_contact_companyIdTocompany        company?            @relation("contact_companyIdTocompany", fields: [companyId], references: [id])
  user                                      user?               @relation(fields: [ownerId], references: [id])
  contactBrief                              contactBrief?
  contactFact                               contactFact[]
  dealContact                               dealContact[]
  emailThread                               emailThread[]
  fieldValue                                fieldValue[]
  formSubmission                            formSubmission[]
  trackedVisitor                            trackedVisitor[]

  @@index([companyId])
  @@index([lastActivityAt])
  @@index([ownerId])
}

model contactBrief {
  contactId   String   @id
  narrative   String
  sections    Json
  score       Float
  sourceUrl   String?
  sessionId   String?
  refreshedAt DateTime @default(now())
  contact     contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model contactFact {
  id           String     @id
  contactId    String
  field        String
  value        String
  score        Float
  band         FactBand
  evidence     Json
  method       String
  sourceUrl    String?
  sessionId    String?
  status       FactStatus @default(PROPOSED)
  decidedById  String?
  decidedAt    DateTime?
  observedAt   DateTime   @default(now())
  supersededAt DateTime?
  contact      contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user         user?      @relation(fields: [decidedById], references: [id])

  @@index([contactId, field, status])
  @@index([status, observedAt])
}

model deal {
  id                String              @id
  name              String
  companyId         String
  ownerId           String
  stage             DealStage           @default(DEMO_BOOKED)
  stageChangedAt    DateTime            @default(now())
  amount            Decimal?            @db.Decimal(14, 2)
  currency          String              @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  closedReason      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  lastActivityAt    DateTime?
  description       String?
  baseAmount        Decimal?            @db.Decimal(24, 4)
  fxRate            Decimal?            @db.Decimal(20, 10)
  fxRateAt          DateTime?
  baseCurrency      String?
  activity          activity[]
  agentConversation agentConversation[]
  company           company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              user                @relation(fields: [ownerId], references: [id])
  dealContact       dealContact[]
  fieldValue        fieldValue[]

  @@index([baseAmount])
  @@index([companyId])
  @@index([currency])
  @@index([expectedCloseDate])
  @@index([lastActivityAt])
  @@index([ownerId])
  @@index([stage])
}

model dealContact {
  dealId    String
  contactId String
  role      String?
  contact   contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
  @@index([contactId])
}

model emailMessage {
  id               String         @id
  threadId         String
  rfcMessageId     String         @unique
  syncedByUserId   String?
  gmailMessageId   String?
  direction        EmailDirection
  fromEmail        String
  fromName         String?
  recipients       Json
  subject          String?
  snippet          String?
  body             String?
  sentAt           DateTime
  createdAt        DateTime       @default(now())
  outlookMessageId String?
  outlookWebLink   String?
  emailThread      emailThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt])
}

model emailThread {
  id             String         @id
  rootMessageId  String         @unique
  subject        String?
  companyId      String?
  contactId      String?
  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  activity       activity?
  emailMessage   emailMessage[]
  company        company?       @relation(fields: [companyId], references: [id])
  contact        contact?       @relation(fields: [contactId], references: [id])

  @@index([companyId, lastMessageAt])
  @@index([contactId, lastMessageAt])
}

model exchangeRate {
  id            String     @id
  baseCurrency  String
  quoteCurrency String
  rate          Decimal    @db.Decimal(20, 10)
  asOf          DateTime
  source        RateSource
  provider      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime

  @@unique([baseCurrency, quoteCurrency, source])
  @@index([baseCurrency, quoteCurrency])
}

model fieldDefinition {
  id          String        @id
  entity      FieldEntity
  key         String
  label       String
  type        FieldType
  agentFilled Boolean       @default(true)
  agentBrief  String?
  required    Boolean       @default(false)
  showOnSheet Boolean       @default(true)
  showOnTable Boolean       @default(false)
  position    Int
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  fieldOption fieldOption[]
  fieldValue  fieldValue[]

  @@unique([entity, key])
  @@index([entity, position])
}

model fieldOption {
  id              String          @id
  fieldId         String
  label           String
  position        Int
  archivedAt      DateTime?
  fieldDefinition fieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldValue      fieldValue[]

  @@index([fieldId, position])
}

model fieldValue {
  id              String          @id
  fieldId         String
  companyId       String?
  contactId       String?
  dealId          String?
  text            String?
  number          Decimal?        @db.Decimal(24, 4)
  date            DateTime?
  bool            Boolean?
  optionId        String?
  userId          String?
  updatedAt       DateTime
  company         company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact         contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal            deal?           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fieldDefinition fieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldOption     fieldOption?    @relation(fields: [optionId], references: [id])
  user            user?           @relation(fields: [userId], references: [id])

  @@unique([fieldId, companyId])
  @@unique([fieldId, contactId])
  @@unique([fieldId, dealId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([fieldId, date])
  @@index([fieldId, number])
  @@index([fieldId, text])
  @@index([optionId])
  @@index([userId])
}

model formSubmission {
  id         String    @id
  visitorId  String?
  contactId  String?
  host       String
  path       String
  email      String?
  fields     Json
  dedupeKey  String    @unique
  filedAt    DateTime?
  skipReason String?
  createdAt  DateTime  @default(now())
  firstTouch Json?
  lastTouch  Json?
  contact    contact?  @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([createdAt])
}

model install {
  id           String    @id
  uuid         String    @unique
  version      String
  lastRollupAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
}

model invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           user         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
}

model mailboxSync {
  id           String           @id
  userId       String
  source       String
  status       GoogleSyncStatus @default(IDLE)
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  retryAfter   DateTime?
  autoCreate   Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime
  user         user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([status])
}

model member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model organization {
  id         String       @id
  name       String
  slug       String       @unique
  logo       String?
  createdAt  DateTime
  metadata   String?
  website    String?
  invitation invitation[]
  member     member[]
}

model rateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model slackChannel {
  id                String    @id
  name              String
  memberCount       Int?
  available         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  inviteRequestedAt DateTime?
  isMember          Boolean   @default(false)
  isPrivate         Boolean   @default(false)
  classifiedAt      DateTime?

  @@index([available, name])
  @@index([updatedAt])
}

model slackInstallation {
  installerId String   @id
  teamId      String
  teamName    String?
  userToken   String?
  userScopes  String
  createdAt   DateTime @default(now())
}

model slackMemberMatch {
  id          String   @id
  crmUserId   String   @unique
  slackUserId String?
  slackHandle String?
  slackEmail  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  user        user     @relation(fields: [crmUserId], references: [id], onDelete: Cascade)

  @@index([slackUserId])
}

model slackWorkspaceGrant {
  id         String   @id
  teamId     String   @unique
  teamName   String?
  userToken  String
  userScopes String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model ssoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String?
  providerId     String  @unique
  organizationId String?
  domain         String
  user           user?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model suppressedContact {
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())
}

model suppressedDomain {
  domain    String   @id
  reason    String?
  createdAt DateTime @default(now())
}

model telemetryCounter {
  name      String   @id
  count     Int      @default(0)
  updatedAt DateTime
}

model telemetryMilestone {
  step      String   @id
  reachedAt DateTime @default(now())
}

model trackedDomain {
  id         String      @id
  host       String      @unique
  scope      DomainScope @default(EXACT_HOST)
  pageViews  Int         @default(0)
  lastSeenAt DateTime?
  createdAt  DateTime    @default(now())
}

model trackedEvent {
  id         String   @id
  visitorId  String
  type       String
  host       String
  path       String
  referrer   String?
  label      String?
  occurredAt DateTime
  source     String?
  medium     String?
  campaign   String?

  @@index([host, occurredAt])
  @@index([occurredAt])
  @@index([source, occurredAt])
  @@index([visitorId, occurredAt])
}

model trackedPageDaily {
  day      DateTime
  host     String
  path     String
  views    Int      @default(0)
  visitors Int      @default(0)

  @@id([day, host, path])
  @@index([host, day])
}

model trackedVisitor {
  id            String    @id
  contactId     String?
  firstSeen     DateTime  @default(now())
  lastSeen      DateTime
  firstSource   String?
  firstMedium   String?
  firstCampaign String?
  firstTerm     String?
  firstContent  String?
  firstReferrer String?
  firstLanding  String?
  firstTouchAt  DateTime?
  lastSource    String?
  lastMedium    String?
  lastCampaign  String?
  lastTerm      String?
  lastContent   String?
  lastReferrer  String?
  lastLanding   String?
  lastTouchAt   DateTime?
  contact       contact?  @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([firstSource])
}

model trackingCounter {
  key       String   @id
  value     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model user {
  id                          String                        @id
  name                        String
  email                       String                        @unique
  emailVerified               Boolean                       @default(false)
  image                       String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime
  account                     account[]
  activity                    activity[]
  agentAuditEvent             agentAuditEvent[]
  agentConversation           agentConversation[]
  agentConversationFeedback   agentConversationFeedback[]
  agentConversationShare      agentConversationShare[]
  agentConversationSubmission agentConversationSubmission[]
  agentDefinition             agentDefinition[]
  agentRun                    agentRun[]
  agentTrigger                agentTrigger[]
  agentVersion                agentVersion[]
  company                     company[]
  contact                     contact[]
  contactFact                 contactFact[]
  deal                        deal[]
  fieldValue                  fieldValue[]
  invitation                  invitation[]
  mailboxSync                 mailboxSync[]
  member                      member[]
  session                     session[]
  slackMemberMatch            slackMemberMatch?
  ssoProvider                 ssoProvider[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
}

model workspaceProfile {
  id          String   @id
  website     String
  narrative   String
  sections    Json
  sourceUrl   String?
  sessionId   String?
  refreshedAt DateTime @default(now())
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STAGE_CHANGE
  ENRICHMENT
}

enum AgentActionStatus {
  PLANNED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentBuilderArtifactStatus {
  WRITING
  READY
}

enum AgentConversationCommandType {
  CHAT
  CREATE_AGENT
}

enum AgentConversationKind {
  RECORD
  BUILDER
}

enum AgentConversationShareScope {
  WORKSPACE_LINK
}

enum AgentConversationSubmissionStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  CANCELLED
}

enum AgentDefinitionStatus {
  DRAFT
  DEPLOYING
  LIVE
  PAUSED
  ARCHIVED
  DELETED
}

enum AgentResponseRating {
  UP
  DOWN
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  WEBHOOK
}

enum AgentVersionStatus {
  DRAFT
  VALIDATING
  READY
  DEPLOYED
  REJECTED
}

enum DealStage {
  DEMO_BOOKED
  QUALIFIED_TO_BUY
  UNQUALIFIED_TO_BUY
  DECISION_MAKER_BOUGHT_IN
  CONTRACT_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum DomainScope {
  SITE_AND_SUBDOMAINS
  EXACT_HOST
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  SKIPPED
}

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

enum FieldEntity {
  COMPANY
  CONTACT
  DEAL
}

enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  CHECKBOX
  SELECT
  URL
  EMAIL
  PHONE
  USER
}

enum GoogleSyncStatus {
  IDLE
  RUNNING
  NEEDS_RECONNECT
  FAILED
}

enum RateSource {
  FETCHED
  MANUAL
}

enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
  TRACKING
}
